WECOM_BOT_ID=
WECOM_BOT_SECRET=
WECOM_ROBOT_NAME=
WECOM_OWNER_IDS=

# auto 表示自动发现本机 opencode 共享后台服务，地址与密码从
# ~/.local/state/opencode/service.json 读取，服务没起来时会执行 opencode service start。
# 只有需要连接远端或独立服务时才写显式地址，例如 http://127.0.0.1:4096，此时必须填 OPENCODE_PASSWORD。
OPENCODE_BASE_URL=auto
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=

WECOM_DEFAULT_DIR=
WECOM_GROUP_DIRS={}
WECOM_ALLOWED_DIRS=[]

STREAM_MIN_CHARS=300
STREAM_MIN_INTERVAL=2
# 0 表示关闭流式，只在开始回一条确认，结束时整段推送，避免碎片刷屏
STREAM_ENABLED=0
# 关闭流式后，长任务每隔多少分钟发一行进度，0 表示不发
STREAM_PROGRESS_MINUTES=5
RENDER_MAX_CHARS=3000
HEARTBEAT_INTERVAL_SEC=18000
CONFIRM_TIMEOUT_SEC=300
# 天气城市，留空则必须显式开启下面的 IP 定位兜底
WECOM_WEATHER_CITY=上海
# 城市留空时是否用 IP 定位兜底，默认 0 关闭。定位走明文 http 且经代理后不准，建议保持关闭
WECOM_WEATHER_IP_FALLBACK=0
